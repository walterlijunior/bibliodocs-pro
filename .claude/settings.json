{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(Get-FileHash *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(npm install -g *)",
      "Bash(npm publish *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push *)",
      "PowerShell(npm install -g *)"
    ],
    "deny": [
      "Edit(/materiais/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.claude/.credentials.json)",
      "PowerShell(Remove-Item *materiais*)"
    ]
  }
}
